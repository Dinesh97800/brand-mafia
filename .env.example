# Copy this file to `.env.local` for XAMPP, and to `.env` / host env vars in production.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=brand_mafia

# SMTP — Gmail needs an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Brand Mafia <hello@brandmafia.com>"
MAIL_ADMIN=hello@brandmafia.com

NEXT_PUBLIC_API_BASE=
