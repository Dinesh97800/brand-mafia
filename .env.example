# Copy this file to `.env.local` for XAMPP, and to `.env` / host env vars in production.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=brand_mafia

# Hostinger business email: smtp.hostinger.com, port 465, SSL.
# Alternative: port 587 with SMTP_SECURE=false (STARTTLS).
# MAIL_FROM must be the same mailbox as SMTP_USER.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Brand Mafia <info@yourdomain.com>"
MAIL_ADMIN=info@yourdomain.com

NEXT_PUBLIC_API_BASE=

# Google reCAPTCHA v2 ("I'm not a robot") — site key is public, secret stays server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
